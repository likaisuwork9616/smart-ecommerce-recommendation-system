  "policies": {
    "fit": "same monthly deadline-clock wait0 training IDs, sorted approval/order-ID rows and train-only preprocessing as the corresponding frozen backbone",
    "historical_scores": "each historical month uses its own monthly model; never final-model rescores of training rows",
    "ranking": "uncalibrated score descending then order_id ascending; threshold zero, fill daily floor(10% * complete eligible scored batch)",
    "label_maturity": "historical validation outcomes strictly before E; unknown labels still compete for full-batch slots",
    "selection": "maximize worst recall of three known-label historical months, then pooled TP, pooled raw AP, fixed candidate order",
    "floor": "30% each historical month is a diagnostic suitability gate; no future recall guarantee",
    "search": "six predeclared cells: Logistic load C1/C.01 and XGBoost geo, each with trend and cross variants; backbone parameters unchanged; no new regularization grid or evaluation early stopping",
    "comparison": "delivery_wait0 versus deadline_wait0 isolates training maturity clock at fixed model/wait; deadline_wait0 versus deadline_wait30 changes training approval wait; old 60-day models provide background only",
    "features": "trend adds13 causal numeric history/approval-load changes; cross adds4 numeric and2 categorical route/promise/load interactions; no target encoding or dispatch additions",
    "probabilities": "classifier scores uncalibrated; ranker sigmoid is a monotone numerical interface conversion, not probability calibration; reject saturation that collapses distinct margins",
    "evaluation_role": "all E months and design have been informed by repeatedly inspected development results; pre-fit specification does not make these periods independent tests",
    "holdout": "original 2018-05-26 onward period not scored",
    "coverage": "eligible valid eventually-delivered cohort only; not every originally approved order",
    "batch_timing": "complete closed calendar-day batches required; up to one day wait; no per-order online cap guarantee",
    "promotion": "new artifacts remain research only; original and prior research models preserved",
    "visualization": "no dashboard or new plots in this experiment; user requested ranking work first",
    "pending_limit": "no cancellation timestamp available; approved cancelled orders can remain pending inside the 30/90-day windows; static master-table location assumption",
    "ranker": "fixed backbone classifiers; old50 candidates are verified/replayed and never refit; no new calibration or threshold",
    "training_clock": "delivery clock is actual delivery; deadline clock is min(actual delivery, midnight after promised calendar date); original actual-delivery metadata and history unchanged",
    "clock_limit": "eventual-delivery cohort remains retrospectively selected; no cancellation outcome labels inferred; assumes original promise date and immediate delivery event availability",
    "paired_comparison": "baseline versus trend isolates the trend package; trend versus cross isolates the four numeric and two categorical crosses, holding training IDs, row order and estimator parameters fixed",
    "geolocation": "seventh file treated as static postal reference available at approval; paired-valid-coordinate per-ZIP median, great-circle distance not road distance; no as-of version metadata or result-based coordinate clipping",
    "dispatch_availability": "no dispatch candidates reused or fitted in this round; frozen preceding sensitivity report retained",
    "primary_selection": "previous50 plus new6; selectors previous_candidates, new_route_load, primary_without_dispatch; maximize worst of three historical month recalls then pooled TP/AP/fixed order",
    "solver": "Logistic retains L2/lbfgs C1 or C.01/max_iter10000; reject ConvergenceWarning or n_iter >= max_iter; solver diagnostics never select models"
  },
