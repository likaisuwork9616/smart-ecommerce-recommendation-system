  "source_previous_features_sha256": "952b43bc5b9046f37d2a33eb1901e5151c182a0b7850122ddad26aadea0e574c",
  "feature_definition": {
    "availability": "Assume raw purchase/approval, original promise, static customer/seller states and item prices/sequences are available at approval. Export has no ingestion/revision timestamps; no promise as-of revision claim. Static geolocation assumption unchanged for XGBoost geo backbone.",
    "raw_population": "All raw orders with non-null purchase/approval and approval >= purchase, including cancelled and unfinished orders; arrival features never read final status, actual delivery or target. Invalid promises still count for routes but not route/promise lanes.",
    "route_key": "primary seller state plus customer state; primary seller is highest item price with item sequence tie-break as in existing history builder; missing keys stay missing and are never pooled",
    "promise_days": "original estimated-delivery calendar date minus approval calendar date; nonnegative integer days only for lanes and promise crosses",
    "promise_bins": [
      "0-7",
      "8-14",
      "15-21",
      "22-30",
      "31+"
    ],
    "lane_key": "route key plus fixed promise bin",
    "windows": {
      "recent_7d": "[t-7 days,t)",
      "previous_7d": "[t-14 days,t-7 days)",
      "recent_14d": "[t-14 days,t)",
      "previous_14d": "[t-28 days,t-14 days)",
      "boundary_policy": "lower endpoint included; upper endpoint excluded; exclude all approvals tied at query timestamp including current order"
    },
    "trend_numeric_features": [
      "route_approvals_7d",
      "route_approvals_previous_7d",
      "route_approvals_14d",
      "route_approvals_previous_14d",
      "route_approval_log_growth_7d",
      "route_approval_log_growth_14d",
      "route_approval_share_change_7d",
      "route_promise_approvals_7d",
      "route_promise_approvals_previous_7d",
      "route_promise_approvals_14d",
      "route_promise_approvals_previous_14d",
      "route_promise_approval_log_growth_7d",
      "route_promise_approval_log_growth_14d"
    ],
    "growth_formula": "log((recent count+1)/(previous count+1)) for route and route/promise lane, separately at7 and14 days; known routes/lanes without past events have zero counts and zero log growth",
    "share_change_formula": "route recent7/global recent7 minus route previous7/global previous7; each global denominator includes all valid raw approvals, regardless of state/promise; zero denominator means missing share/change",
    "cross_numeric_formulas": {
      "promise_x_route_growth_7d": "(valid promise_days/30) * route_approval_log_growth_7d",
      "promise_x_lane_growth_7d": "(valid promise_days/30) * route_promise_approval_log_growth_7d",
      "margin_x_route_growth_7d": "(route_promise_margin_p90_days/30) * route_approval_log_growth_7d",
      "promise_x_route_overdue_share_30d": "(valid promise_days/30) * route_overdue_pending_share_30d"
    },
    "cross_numeric_features": [
      "promise_x_route_growth_7d",
      "promise_x_lane_growth_7d",
      "margin_x_route_growth_7d",
      "promise_x_route_overdue_share_30d"
    ],
    "cross_categorical_features": [
      "state_route_promise_bin",
      "state_route_promise_growth_bin"
    ],
    "cross_categorical_formulas": {
      "state_route_promise_bin": "state_route|promise_bin; missing if either route state or promise invalid",
      "state_route_promise_growth_bin": "state_route|promise_bin|lane growth direction; increase if lane7 log growth > log1.25, decrease if < -log1.25, otherwise stable including boundaries"
    },
    "growth_direction_threshold": 0.22314355131420976,
    "preprocessing": "Train-only numeric median/missing indicators (plus StandardScaler for Logistic) and categorical most-frequent/OneHotEncoder min_frequency20, unknown ignore; existing backbone contract unchanged.",
    "package_contrast": "trend adds13 numeric features; cross includes trend plus4 numeric and2 categorical interactions; all old91 features/metadata remain in frozen cache but model whitelists exclude dispatch"
  }
}