  "sequence": [
    "user_confirmation",
    "prepare_allowed_changes_and_static_review_only",
    "seal_tools_cases_closure_then_README_commit_push",
    "verify_original_fixture_bytes_and_rebind_registry_then_README_commit_push",
    "one_complete_formal_window",
    "readonly_receipt_and_stop_evidence_audit_then_README_commit_push"
  ],
  "static_gate": [
    "AST_no_suite_import_or_execution",
    "all_34_method_bijection_and_class_method_suffix_unchanged",
    "all_196_exact_case_IDs_no_add_drop_duplicate",
    "all_24_family_memberships_preserved",
    "actual_direct_recursive_and_dynamic_source_closure",
    "strict_original_manifest_and_source_identity",
    "mechanical_diff_allowlist_and_precise_A09_expectations",
    "deadline_and_full_verdict_review"
  ],
  "formal_limits": {
    "maximum_windows": 1,
    "automatic_correction_windows": 0,
    "success_deadline_seconds": 900,
    "child_timeout_seconds_maximum": 120,
    "child_also_bounded_by_remaining_window": true,
    "start_marker_reuse": false,
    "fail_fast": true,
    "receipt_deadline_veto": true,
    "safe_cleanup_and_failure_evidence_may_exceed_success_deadline": true,
    "OS_return_within_900_seconds_guaranteed": false
  },
  "stop_rules": [
    "preparation_scope_requires_scientific_or_golden_or_ID_or_threshold_change",
    "preparation_reaches_120_minutes_without_complete_seals",
