{
  "format_version": 1,
  "planned_outputs": {
    "cutpoint_aggregate_if_later_authorized": [
      "reference_ID_count",
      "axis",
      "percentages",
      "raw_cut_values",
      "effective_levels",
      "bin_counts",
      "neutral_joint_cell_counts",
      "support_flags",
      "gate_status"
    ],
    "description_aggregate": [
      "source_version",
      "routing_counts",
      "eligible_n",
      "axes_and_units",
      "statistics_and_null_reasons",
      "shape_and_tail_diagnostics",
      "outlier_flags_not_removed",
      "population_and_money_conservation",
      "gate_status",
      "limitations"
    ],
    "fit_parameters": "reference_or_resample_only_no_review_delay_outcome_or_future_snapshot_input",
    "future_private_namespace": ".runtime/stage6_rfm_evaluation_v1/",
    "private_individual_outputs": "none_in_current_round_future_only_separately_authorized_ID_tuple_ledger_with_guard",
    "public_outputs": "aggregate_only_no_customer_ID_individual_RFM_or_private_bundle_digests",
    "sensitivity_aggregate_if_later_authorized": [
      "seed",
      "sample_n",
      "reference_n",
      "levels",
      "cuts",
      "bin_counts",
      "axis_agreement",
      "joint_ARI",
      "degeneracy_and_support_flags",
      "gate_status"
    ],
    "status": "future_schema_only_none_created_this_round"
  },
  "policy": {
    "current_run": {
      "CSV_content_parsed": false,
      "customer_scores_or_groups_created": false,
      "cutpoints_estimated": false,
      "dashboard": false,
      "descriptive_statistics_computed": false,
      "individual_RFM_recomputed": false,
      "model_fits": 0,
      "resampling_executed": false
    },
    "cutpoints": {
      "assignment": "raw_value<=cut_is_lower_numeric_bin_else_next_right_closed_bin",
      "candidate": "single_unweighted_empirical_marginal_quantile_rule_reference_not_trained_clusters",
      "constant_axis": "one_effective_level_no_separation_full_three_axis_candidate_ineligible",
      "direction": "numeric_bin_1_to_k_R_score=k+1-bin_F_and_M_score=bin",
      "effective_levels": "unique_retained_cuts_plus_1_report_all_bin_N_empty_bins_fail_no_claim_of_five_equal_bins",
      "estimator": "same_exact_integer_rank_empirical_quantile_as_description",
      "joint_cells": "observed_R_F_M_tuple_cells_max125_not_selected_business_group_count",
      "names": "neutral_axis_bin_or_tuple_only_no_VIP_churn_LTV_or_action_claims",
      "no_posthoc_merging": "no_manual_cuts_tie_splitting_or_merging_sparse_cells_to_pass",
      "percentages": [
        20,
        40,
        60,
        80
      ],
      "reference": "all_active_complete_IDs_canonical_ascending",
      "representation": "tuple_of_three_ordinals_and_per_axis_level_counts_not_sum_or_weighted_value",
      "status": "planned_unestimated_not_authorized_to_assign_this_round",
      "ties": "deduplicate_cut_values_keep_min_cut_if_lt_max_drop_cut_ge_max_no_ID_or_row_tie_break"
    },
    "decision_gates": {
      "G0_source_and_routing": "any_source_guard_schema_ID_state_domain_or_conservation_failure_stop",
      "G1_description": "complete_specified_summaries_and_denominators_with_all_null_degeneracies_declared",
      "G2_rule_candidate": "only_after_separate_authorization_and_G1_acceptance_min2_levels_all_axes_support_and_reproducibility",
      "G3_sensitivity": "all_five_seeds_pass_declared_levels_per_axis_bin_support_agreement_ARI_degeneracy_checks",
      "business_or_temporal_release": "pending_data_not_granted_even_if_G1_G2_G3_pass",
      "clustering_models": "algorithm_k_scaler_weights_and_model_selection_unset_requires_separate_future_contract",
      "current": "only_specification_and_metadata_reuse_accepted_no_G1_G2_G3_execution",
      "failure": "retain_descriptive_results_and_failed_checks_no_recut_reseed_reweight_or_threshold_change_this_version",
      "future_implementation": "next_decide_description_only_read_only_implementation_and_synthetic_leakage_checks_first",
      "joint_cell_support": "small_joint_cell_flags_do_not_fail_global_ARI_gate_but_that_cell_is_not_accepted_as_stable"
    },
    "description": {
      "Bowley_skewness": "(Q75+Q25-2*Q50)/(Q75-Q25)_null_if_IQR0",
      "axes": [
        "recency_seconds",
        "frequency_orders",
        "monetary_product_cents"
      ],
      "cohort": "active_complete_only_for_joint_RFM_and_numeric_summaries",
      "empty_cohort": "N0_other_statistics_null_reason_empty_reference_G1_not_evaluable_no_cutpoints",
      "integer_rank": "(n*p+99)//100_for_positive_integer_percent_p",
      "mean": "exact_integer_sum_and_n_recorded_float_display_only_no_currency_rounding_in_source",
      "partial_quality_cohorts": "counts_and_null_masks_only_no_pooled_partial_R_F_distribution",
      "quantile_percentages": [
        0,
        1,
        5,
        25,
        50,
        75,
        95,
        99,
        100
      ],
      "quantile_rule": "sorted_x_rank_1_if_p0_else_ceil(n*p/100)_1_based_no_interpolation",
      "shape_diagnostics": "report_values_without_declaring_success_threshold_for_skew_or_repeat_rate",
      "specials": [
        "F_equals_1_count_and_fraction",
        "M_equals_0_count_and_fraction",
        "M_ge_Q99_count_fraction_and_share_of_total_M_include_all_threshold_ties"
      ],
      "statistics": [
        "n",
        "null_count",
        "distinct_count",
        "min",
        "max",
        "arithmetic_mean",
        "empirical_quantiles",
        "IQR",
        "Bowley_skewness"
      ],
      "zero_total_M_share": null
    },
    "input": {
      "F": "frequency_orders_distinct_eligible_window_orders_int64",
      "M": "monetary_product_cents_nonnegative_int64_nominal_BRL_product_gross_snapshot",
      "R": "recency_seconds_exact_integer_for_order_statistics_display_seconds_div_86400_days",
      "S_inclusive": "2017-09-01 00:00:00",
      "T_exclusive": "2018-09-01 00:00:00",
      "clock": "source_naive_seconds_no_timezone_assignment",
      "namespace": ".runtime/stage6_rfm_dataset_v1/",
      "no_rebuild_repair_new_window_or_additional_sources": true,
      "reuse": "accepted_v1_only_complete_27_source_bindings_and_private_guard_before_after"
    },
    "outliers_and_scale": {
      "IQR0": "degenerate_axis_flag_fence_counts_null_report_distinct_and_tail_mass_no_division_by_zero",
      "IQR_fences": "Q25-1.5*IQR_and_Q75+1.5*IQR_strict_outside_count_when_IQR_gt0",
      "default": "flags_only_no_delete_no_winsorization_no_clip_no_change_to_source_RFM",
      "domain_failure": "R_not_in_(0,365days]_or_F_lt1_or_M_lt0_or_required_null_nonfinite_stop",
      "fence_precision": "compare_2*x_lt_2*Q25-3*IQR_or_2*x_gt_2*Q75+3*IQR_exact_integers_display_denominator2_no_rounding",
      "log_partition": "not_a_second_quantile_candidate_monotone_view_not_independent_stability_evidence",
      "log_view": "secondary_descriptive_log1p(R_seconds/86400)_log1p(F)_log1p(M_cents/100)_finite_only",
      "log_view_outliers": "none_flags_and_fences_are_raw_scale_only_no_separate_cutpoints_or_gate",
      "log_view_statistics": [
