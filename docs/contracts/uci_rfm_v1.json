    "serialization": "UTF8_LF_CSV_header_null_empty_true_false_boolean_integers_base10_nested_lists_JSON_arrays_sorted; JSON_no_NaN; timestamps_YYYY_MM_DD_HH_MM_SS",
    "manifest": "contract_source_and_code_hashes_schema_counts_per_file_bytes_hashes_state_counts_reconciliations_and_independent_readback",
