{
  "contract_id": "uci_online_retail_ii_retrospective_rfm_v1",
  "contract_version": 1,
  "purpose": "independent_retrospective_RFM_and_temporal_description",
  "history_start": "2009-12-01 00:00:00",
  "clock": "source_naive_whole_seconds_no_timezone_or_DST_assignment",
  "windows": [
    {"id": "T1", "start_inclusive": "2009-12-01 00:00:00", "cutoff_exclusive": "2010-12-01 00:00:00", "days": 365, "role": "reference_only_for_cutpoints"},
    {"id": "T2", "start_inclusive": "2010-12-01 00:00:00", "cutoff_exclusive": "2011-12-01 00:00:00", "days": 365, "role": "retrospective_temporal_comparison_not_unseen_test"}
  ],
  "tail_policy": "events_at_or_after_2011_12_01_excluded_from_both_snapshots_not_a_holdout",
  "prior_exposure": {
    "full_file_quality_and_monthly_amounts_inspected": true,
    "exploratory_cutoffs_previously_inspected": ["2010-12-01", "2011-06-01"],
    "exploratory_june_cutoff_selected_for_this_study": false,
    "previous_full_file_coherent_candidates_are_not_frozen_dataset_counts": true,
    "pristine_holdout_available": false
  },
  "source": {
    "workbook": "data/raw/online_retail_ii/online_retail_II.xlsx",
    "sheets_in_priority_order": ["Year 2009-2010", "Year 2010-2011"],
    "headers": ["Invoice", "StockCode", "Description", "Quantity", "InvoiceDate", "Price", "Customer ID", "Country"],
    "audit_database_role": "byte_bound_read_only_decoded_source_rows_only_never_global_unique_or_coherent_views",
    "normalization": "same_decoded_eight_fields_as_intake_numeric_scalars_to_decimal_text_blank_to_null_other_strings_preserved",
    "source_row_key": ["sheet", "excel_row"],
    "customer_key_regex": "[0-9]{5}",
    "purchase_invoice_regex": "[0-9]{6}",
    "cancellation": "case_insensitive_C_prefix",
    "identity_assumption": "same_recorded_customer_key_across_years_is_a_proxy_not_verified_non_reuse_or_same_person",
    "fatal_structural_errors": ["changed_source_bytes_or_headers_or_sheets", "missing_or_unparseable_or_timezone_or_fractional_second_timestamp", "event_before_history_start", "nonblank_customer_not_matching_five_ascii_digits", "formula_cell", "integer_or_amount_overflow"],
    "missing_customer": "retain_in_unlinked_ledger_no_imputation_no_synthetic_shared_customer_no_country_matching"
  },
  "processing_order": [
    "verify_source_bundle_and_structural_parse",
    "for_each_T_filter_history_start_le_timestamp_lt_T_before_any_invoice_group_or_customer_universe",
    "build_universe_from_all_valid_known_customer_keys_in_this_prefix_independent_of_purchase_or_money",
    "classify_invoice_headers_using_only_this_prefix",
    "apply_predeclared_duplicate_arm_within_this_prefix_and_preserve_source_row_mapping",
    "classify_rows_and_purchase_invoice_quarantine",
    "build_history_and_window_eligible_invoice_ledger",
    "aggregate_all_universe_customers_and_mask_window_quality_quarantine",
    "verify_reconciliation_and_write_complete_bundle_once"
  ],
  "duplicate_policy": {
    "key": "all_eight_normalized_decoded_fields_including_description_and_date_not_invoice_or_invoice_stock_only",
    "main": "one_per_exact_eight_field_group",
    "main_representative": "first_sheet_in_priority_order_then_lowest_excel_row",
    "sensitivity": "max_per_sheet_multiplicity_per_exact_group",
    "sensitivity_representative": "choose_sheet_with_largest_group_count_then_sheet_priority_tie_break_keep_all_group_rows_in_that_sheet",
    "mapping": "each_original_prefix_row_to_group_representative_retained_or_duplicate_excess_and_arm",
    "no_line_key_claim": "exact_matches_are_an_assumption_not_proven_errors",
    "nonidentical_rows_same_invoice_stock": "retain_unless_separate_quality_rule_applies"
  },
  "invoice_policy": {
    "header_scope": "all_pre_T_rows_with_the_same_nonblank_invoice_before_duplicate_or_price_filter",
    "conflict_conditions": ["multiple_distinct_timestamps", "multiple_distinct_known_customer_keys", "mixed_missing_and_known_customer", "multiple_distinct_countries_including_missing"],
    "conflict_action": "quarantine_entire_numeric_purchase_invoice_never_choose_min_max_or_split_by_timestamp",
    "missing_invoice": "quarantine_row_do_not_invent_invoice_id",
    "all_customer_missing": "unlinked_invoice_not_customer_RFM",
    "blank_country": "retained_and_flagged_if_consistently_missing_not_inferred",
    "description_missing": "retained_flag_only_never_used_to_guess_customer_or_price",
    "missing_stock": "quarantine_entire_numeric_purchase_invoice",
    "bad_purchase_numeric_lines": "any_missing_nonfinite_nonintegral_or_nonpositive_quantity_or_missing_nonfinite_negative_price_quarantines_entire_numeric_purchase_invoice",
    "zero_price": "valid_positive_integer_quantity_zero_price_line_excluded_as_free_line_not_paid_activity_not_quality_quarantine",
    "valid_paid_line": "numeric_purchase_invoice_consistent_header_known_customer_nonblank_stock_positive_integral_quantity_positive_price",
    "eligible_purchase_invoice": "not_quarantined_and_at_least_one_valid_paid_line_in_chosen_duplicate_arm",
    "cancellations": "all_C_prefix_rows_excluded_from_R_F_M_regardless_of_sign_retained_separate_signed_ledger",
    "other_nonnumeric_invoice": "excluded_adjustment_document_retained_separate_signed_ledger",
    "refund_matching": "none_no_C_suffix_match_no_future_cancellation_retroactive_netting",
    "quarantine_linkage": "link_all_valid_known_customer_keys_on_quarantined_invoice_using_only_prefix; window_flag_if_any_member_timestamp_in_S_T; missing_invoice_row_links_own_known_key",
    "past_only_quarantine": "retain_history_diagnostic_does_not_mask_clean_current_window",
    "row_primary_reason_precedence": ["cancellation_document", "other_adjustment_document", "missing_invoice", "header_conflict", "unknown_customer", "invalid_purchase_numeric_or_missing_stock", "duplicate_excess", "zero_price_free_line", "eligible_paid_line"],
    "multi_reason_flags": "preserve_all_flags_alongside_exactly_one_primary_reason; duplicate_counts_also_reported_independently"
  },
  "money": {
    "currency": "nominal_GBP",
    "unit": "0.001_GBP",
    "integer_units_per_GBP": 1000,
    "maximum_price_decimal_places": 3,
    "arithmetic": "Decimal_of_decoded_text_to_exact_integer_units_times_integer_quantity_checked_signed_int64_sums_no_float_rounding",
    "extra_precision": "stop_and_request_new_contract_version_not_round",
    "main_scope": "all_valid_paid_lines_including_nonstandard_stock_codes_fees_or_adjustments_if_positive",
    "main_name": "positive_invoice_line_gross_value_proxy_including_possible_fees_not_product_revenue_or_net_revenue",
    "standard_code_regex": "[0-9]{5}[A-Za-z]*",
    "sensitivity_scope": "only_paid_lines_matching_standard_code_regex_contribute_to_M; R_F_and_invoice_eligibility_unchanged",
    "sensitivity_zero": "M_may_be_zero_for_active_fee_only_invoice_under_standard_code_scope_not_missing",
    "stock_semantics": "regex_is_a_shape_filter_not_authoritative_product_taxonomy",
    "extremes": "retain_flag_min_max_P99_no_winsorization_or_log_transform_for_RFM",
    "net_revenue_supported": false,
    "cost_profit_LTV_supported": false
  },
  "arms": [
    {"id": "main", "duplicates": "one_per_exact_eight_field_group", "money": "all_paid_codes"},
    {"id": "duplicate_sensitivity", "duplicates": "max_per_sheet_multiplicity_per_exact_group", "money": "all_paid_codes"},
    {"id": "code_sensitivity", "duplicates": "one_per_exact_eight_field_group", "money": "standard_code_shape_only"},
    {"id": "combined_sensitivity", "duplicates": "max_per_sheet_multiplicity_per_exact_group", "money": "standard_code_shape_only"}
  ],
  "universe_and_rfm": {
    "universe": "all_valid_known_keys_observed_in_any_history_prefix_row_including_cancellation_adjustment_free_or_quarantined_rows",
    "T1_subset_T2_required": true,
    "R_seconds": "T_minus_latest_eligible_window_invoice_time_exact_integer_seconds_range_1_to_31536000",
    "R_days_display": "R_seconds_divided_by_86400_rounded_6_decimals_for_display_only_cutpoints_use_seconds",
    "F": "count_distinct_eligible_invoice_keys_with_S_le_invoice_time_lt_T_never_line_count",
    "M": "sum_selected_arm_paid_line_integer_0_001_GBP_units_on_the_same_window_eligible_invoices",
    "window_quarantine": "any_linked_window_quality_quarantine_masks_all_primary_R_F_M_to_null_keep_partial_values_in_separate_diagnostic_fields",
    "clean_no_window_invoice": "R_null_F_0_M_0_not_missing",
    "states": ["active_complete", "inactive_complete", "observed_no_eligible_history", "active_with_quarantine", "inactive_with_quarantine"],
    "state_precedence": "window_quarantine_then_F_positive_then_history_eligible_invoice_positive_else_observed_no_eligible_history",
    "numeric_evaluation_eligible": "active_complete_only",
    "history_counts": "eligible_invoice_history_from_2009_12_01_to_T_not_lifetime_history",
    "new_observed_key": "in_U2_not_U1_not_proven_new_customer",
    "no_purchase_or_inactivity": "not_a_churn_label_no_unobserved_global_customer_registry"
  },
  "evaluation": {
    "role": "retrospective_descriptive_temporal_comparison_no_predictive_performance_or_business_effect_claim",
    "reference": "main_T1_active_complete_only",
    "minimum_reference_active_complete": 200,
    "insufficient_reference": "descriptive_and_state_counts_only_no_cutpoints_or_scores_do_not_change_dates",
    "cutpoint_probabilities": [0.2, 0.4, 0.6, 0.8],
    "quantile": "inverse_empirical_CDF_sorted_x_at_ceil_n_p_1_based_no_interpolation",
    "quantile_endpoints": "p_0_is_minimum_p_1_is_maximum",
    "cutpoint_cleanup": "unique_sorted_thresholds_strictly_less_than_reference_maximum",
    "ties": "never_split_ties_by_ID_or_random_jitter",
    "score": "j=count_thresholds_strictly_less_than_value; F_M=j+1; R=K-j; K=number_of_thresholds+1; equality_in_lower_value_bin",
    "constant_axis": "K_1_score_1_report_degenerate",
    "apply": "save_main_T1_cutpoints_once_apply_unchanged_to_T2_and_all_sensitivity_arms_no_T2_refit_or_best_arm_selection",
    "descriptive_quantiles": [0, 0.25, 0.5, 0.75, 0.95, 0.99, 1],
    "all_universe_reports": ["universe_and_state_counts", "5_by_5_state_transition_counts_on_U1", "new_observed_keys_separately", "unknown_customer_rows_and_amount_share_by_window", "exclusion_and_duplicate_reconciliation_by_arm"],
    "numeric_reports": ["R_F_M_distribution_on_each_active_complete_population", "F_ge_2_share_with_active_denominator", "paired_T2_minus_T1_quantiles_on_both_active_complete", "paired_absolute_change_P50_P90", "paired_Spearman_with_average_tied_ranks", "per_axis_exact_and_within_one_score_agreement", "joint_tuple_exact_agreement", "fixed_tuple_partition_ARI", "per_axis_and_joint_transition_counts_and_T1_row_normalized_rates"],
    "paired_panel": "U1_members_active_complete_at_both_T; always_report_n_over_U1_and_each_active_population_and_excluded_states",
    "minimum_paired_for_correlations_and_ARI": 200,
    "degenerate_metrics": "Spearman_null_if_either_axis_constant; ARI_null_if_zero_denominator; insufficient_n_metrics_null_with_reason; never_report_vacuous_100_percent",
    "support_minimum": "max_50_and_ceiling_0_01_times_that_snapshot_active_complete_population",
    "support_applies_to": "each_axis_bin_and_each_nonempty_joint_tuple_for_each_T_and_arm; zero_bins_report_empty; list_count_and_people_in_under_supported_groups",
    "small_group_use": "no_group_level_business_claim_when_under_supported; do_not_merge_bins_or_change_thresholds_after_results",
    "sensitivity_reports": "paired_same_T_same_customer_against_main_all_three_arms; M_delta_quantiles_total_delta_relative_delta_if_main_nonzero_score_agreement_and_support; common_universe_states_R_F_must_be_identical",
    "temporal_pass_fail": "no_arbitrary_stability_pass_threshold_natural_behavior_change_is_not_model_failure",
    "uncertainty_and_scope": "descriptive_sample_statistics_no_population_CI_no_claim_of_causal_effect_or_future_generalization",
    "retuning": "no_window_threshold_seed_scope_or_arm_selection_using_T2; change_requires_new_version_and_retrospective_disclosure",
    "new_training_or_G3_resampling": false
  },
